NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Plantilla sin secreto real. Preferir npm run setup:local; nunca copiar sobre .env existente.
# Opcional para validate/generate; la API no conecta al iniciar.
DATABASE_URL=postgresql://whatscommerceec_dev:CHANGE_ME@127.0.0.1:5432/whatscommerceec_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379
# Solo Compose local: el usuario de bootstrap NO es el futuro rol runtime RLS.
POSTGRES_USER=whatscommerceec_dev
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=whatscommerceec_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
# Preparación solamente: mantener false hasta revisar/aplicar SQL con autorización.
AUTH_ENABLED=false
# No usar DATABASE_URL/usuario administrativo para estos pools separados.
# AUTH_IDENTITY_DATABASE_URL=postgresql://wc_identity:CHANGE_ME@127.0.0.1:5432/whatscommerceec_dev
# AUTH_TENANT_DATABASE_URL=postgresql://wc_tenant:CHANGE_ME@127.0.0.1:5432/whatscommerceec_dev
# Claves independientes de 32 bytes aleatorios, base64url canónico sin padding.
# Generarlas solo con autorización; no copiar placeholders ni credenciales de DB.
# AUTH_JWT_KEY=
# AUTH_CURSOR_KEY=
# AUTH_RATE_LIMIT_KEY=
