{
  "name": "whatscommerceec-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API modular de WhatsCommerce EC",
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.config.cjs --runInBand",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:sql": "tsx scripts/render-schema-sql.ts",
    "prisma:sql:check": "tsx scripts/render-schema-sql.ts --check",
    "check:persistence": "tsx scripts/check-persistence.ts",
    "auth:setup:local": "tsx scripts/auth-local.ts setup",
    "auth:bootstrap:local": "tsx scripts/bootstrap-platform.ts",
    "recovery:setup:local": "tsx scripts/recovery-setup.ts",
    "recovery:apply:local": "tsx scripts/recovery-apply.ts",
    "recovery:worker": "tsx scripts/recovery-worker.ts",
    "gmail:authorize:local": "tsx scripts/gmail-authorize.ts",
    "gmail:verify:local": "tsx scripts/gmail-verify.ts",
    "test:recovery:postgres": "tsx test/recovery-postgres.ts",
    "test:auth:real": "tsx test/auth-real.ts",
    "test:persistence": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=\"persistence-artifacts|render-schema-sql\"",
    "setup:local": "tsx scripts/setup-local.ts",
    "infra:up": "tsx scripts/infra-compose.ts up",
    "infra:status": "tsx scripts/infra-compose.ts status",
    "check:infra": "tsx scripts/check-infra.ts",
    "test:infra": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=scripts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "bullmq": "6.6.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^17.2.3",
    "ioredis": "5.8.2",
    "jose": "6.2.15",
    "nodemailer": "10.4.0",
    "pg": "8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "10.14.0",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.15",
    "tsc-watch": "7.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
